# Copia este archivo como .env (local) o crea las variables en Vercel → Settings → Environment Variables.
# Si una variable está vacía, ese píxel simplemente no se carga.

# Meta Pixel (Administrador de eventos de Meta) — ej. 123456789012345
VITE_META_PIXEL_ID=

# Google Analytics 4 — ej. G-XXXXXXXXXX
VITE_GA4_ID=
